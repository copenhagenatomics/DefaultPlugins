<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:notation="http://www.eclipse.org/gmf/runtime/1.0.2/notation" xmlns:sgraph="http://www.yakindu.org/sct/sgraph/2.0.0">
  <sgraph:Statechart xmi:id="_wIjwoDgWEe6Fz5PT9Y06Cg" specification="// &#x9;&#x9;The purpose of this plugin is to limit the power usage of&#xD;&#xA;//&#x9;&#x9;a set of heaters to not exceed a given limit.&#xD;&#xA;//&#xD;&#xA;//&#x9;&#x9;This plugin is meant to be used in tandem with a &#xD;&#xA;//&#x9;&#x9;power_control_current_sampling plugin. This plugin will wait until&#xD;&#xA;//&#x9;&#x9;power_control_current_sampling has sampled the current usage&#xD;&#xA;//&#x9;&#x9;for at least one heater.&#xD;&#xA;//&#x9;&#x9;This plugin has been to be placed BEFORE the &#xD;&#xA;//&#x9;&#x9;power_control_current_sampling plugin in the IO.conf&#xD;&#xA;//&#xD;&#xA;// &#x9;&#x9;Note: Currently doesn't check the state of relevant AC and temperature boards!&#xD;&#xA;&#xD;&#xA;interface:&#xD;&#xA;&#x9;in event vector&#xD;&#xA;&#x9;&#xD;&#xA;interface conf:&#xD;&#xA;    var MaxCurrent : real = 20.0&#xD;&#xA;    var MaxCurrentUpdates: integer = 0&#xD;&#xA;    &#xD;&#xA;// Interface for variables owned by this plugin&#xD;&#xA;interface this:&#xD;&#xA;&#x9;in event update_maxCurrent : real&#xD;&#xA;&#x9;var currentSampled  : boolean&#xD;&#xA;&#x9;var unlimitedTotalCurrent: real&#xD;&#xA;&#x9;var maxCurrent: real&#xD;&#xA;&#x9;var pwmPct: real&#xD;&#xA;   &#xD;&#xA;interface fieldlist:&#xD;&#xA;&#x9;in event Heaters_foreach&#xD;&#xA;&#x9;var Heaters_onoff: real&#xD;&#xA;&#x9;var Heaters_currentsampled: real&#xD;&#xA;&#x9;var Heaters_targetoutput: real&#xD;&#xA;&#x9;&#xD;&#xA;interface this_fieldlist:&#xD;&#xA;&#x9;var Heaters_onoff_cache: real" name="power_control" domainID="com.yakindu.domain.scxml">
    <regions xmi:id="_wIsTizgWEe6Fz5PT9Y06Cg" name="main region">
      <vertices xsi:type="sgraph:Entry" xmi:id="_wIsTjDgWEe6Fz5PT9Y06Cg">
        <outgoingTransitions xmi:id="_wIsTjTgWEe6Fz5PT9Y06Cg" target="_ZVdRoGQbEe6JObGIEUNaPg"/>
      </vertices>
      <vertices xsi:type="sgraph:State" xmi:id="_ZVdRoGQbEe6JObGIEUNaPg" specification="entry /&#xD;&#xA;&#x9;this.maxCurrent = conf.MaxCurrent" name="config check" incomingTransitions="_wIsTjTgWEe6Fz5PT9Y06Cg">
        <outgoingTransitions xmi:id="_DvGmcGm8Ee6asKjHHob8lQ" specification="" target="_26iYAHmDEe6tkd80gMFuiQ"/>
      </vertices>
      <vertices xsi:type="sgraph:State" xmi:id="_26iYAHmDEe6tkd80gMFuiQ" specification="" name="running" incomingTransitions="_DvGmcGm8Ee6asKjHHob8lQ _cutvwNfHEe6CmuIC25W7Qw">
        <outgoingTransitions xmi:id="_3TpccNfGEe6CmuIC25W7Qw" specification="this.update_maxCurrent" target="_3TlLANfGEe6CmuIC25W7Qw"/>
        <regions xmi:id="_PzvGwIO3Ee67htl5QhuJrQ">
          <vertices xsi:type="sgraph:State" xmi:id="_Pz6tBYO3Ee67htl5QhuJrQ" specification="entry / &#xD;&#xA;&#x9;this.unlimitedTotalCurrent = 0&#xD;&#xA;&#xD;&#xA;// Calculate (desired) total current&#xD;&#xA;fieldlist.Heaters_foreach /&#xD;&#xA;&#x9;this.currentSampled = fieldlist.Heaters_currentsampled > 0;&#xD;&#xA;&#x9;this.unlimitedTotalCurrent += (this.currentSampled ? fieldlist.Heaters_currentsampled * fieldlist.Heaters_targetoutput : 0.0)&#xD;&#xA;&#xD;&#xA;// Calculate reduction factor and update all heaters&#xD;&#xA;fieldlist.Heaters_foreach /&#xD;&#xA;    this.pwmPct = this.unlimitedTotalCurrent > 0.0 ? this.maxCurrent / this.unlimitedTotalCurrent : 0.0;&#xD;&#xA;&#x9;this.pwmPct = (this.pwmPct > 1.0 ? 1.0 : this.pwmPct);&#xD;&#xA;&#x9;this.currentSampled = fieldlist.Heaters_currentsampled > 0;&#xD;&#xA;&#x9;this_fieldlist.Heaters_onoff_cache = this.currentSampled ? this.pwmPct * fieldlist.Heaters_targetoutput : 0.0;&#xD;&#xA;&#x9;fieldlist.Heaters_onoff = this_fieldlist.Heaters_onoff_cache" name="calculate and update" incomingTransitions="_Pz43xIO3Ee67htl5QhuJrQ _ooPJ0NEvEfGJ1ppCW3KjsQ _cXpakNEyEfGJ1ppCW3KjsQ">
            <outgoingTransitions xmi:id="_P0BaoIO3Ee67htl5QhuJrQ" specification="[this.unlimitedTotalCurrent > 0]" target="_Pzw78IO3Ee67htl5QhuJrQ"/>
          </vertices>
          <vertices xsi:type="sgraph:State" xmi:id="_Pzw78IO3Ee67htl5QhuJrQ" specification="// the entry and the first foreach detect if any heaters are off so we can turn off without the usual 1 second delay&#xD;&#xA;// this helps remove delays in cases where all heaters are turned off to measure temperatures&#xD;&#xA;// note: we reuse the currentSampled channel for the all heaters off detection to avoid introducing an extra channel &#xD;&#xA;entry / &#xD;&#xA;    this.currentSampled = false&#xD;&#xA;fieldlist.Heaters_foreach /&#xD;&#xA;&#x9;this.currentSampled |= fieldlist.Heaters_targetoutput > 0&#xD;&#xA;    &#xD;&#xA;//hold heaters on the power level during 1 second&#xD;&#xA;fieldlist.Heaters_foreach /&#xD;&#xA;&#x9;fieldlist.Heaters_onoff = this_fieldlist.Heaters_onoff_cache&#x9;" name="hold" incomingTransitions="_P0BaoIO3Ee67htl5QhuJrQ">
            <outgoingTransitions xmi:id="_ooPJ0NEvEfGJ1ppCW3KjsQ" specification="after 1s" target="_Pz6tBYO3Ee67htl5QhuJrQ"/>
            <outgoingTransitions xmi:id="_cXpakNEyEfGJ1ppCW3KjsQ" specification="[this.currentSampled]" target="_Pz6tBYO3Ee67htl5QhuJrQ"/>
          </vertices>
          <vertices xsi:type="sgraph:Entry" xmi:id="_PzwU4IO3Ee67htl5QhuJrQ">
            <outgoingTransitions xmi:id="_Pz43xIO3Ee67htl5QhuJrQ" specification="" target="_Pz6tBYO3Ee67htl5QhuJrQ"/>
          </vertices>
        </regions>
      </vertices>
      <vertices xsi:type="sgraph:State" xmi:id="_3TlLANfGEe6CmuIC25W7Qw" specification="entry /&#xD;&#xA;&#x9;this.maxCurrent = conf.MaxCurrentUpdates == 1 ? valueof(this.update_maxCurrent) : this.maxCurrent" name="UpdatingMaxCurrent" incomingTransitions="_3TpccNfGEe6CmuIC25W7Qw">
        <outgoingTransitions xmi:id="_cutvwNfHEe6CmuIC25W7Qw" specification="vector" target="_26iYAHmDEe6tkd80gMFuiQ"/>
      </vertices>
    </regions>
  </sgraph:Statechart>
