<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:viz="http://visual-scxml-editor/metadata" version="1.0" name="pid" initial="mainregion">
  <datamodel>
    <data expr="0.0" id="this_input"/>
    <data expr="0.0" id="this_output"/>
    <data expr="0.0" id="this_target"/>
    <data expr="0.1" id="conf_proportionalGain"/>
    <data expr="600.0" id="conf_integralTime"/>
    <data expr="0.0" id="conf_derivativeTime"/>
    <data expr="20" id="conf_controlPeriod"/>
    <data expr="0" id="conf_offTime"/>
    <data expr="40" id="conf_trackingTime"/>
    <data expr="0.0" id="conf_minOutput"/>
    <data expr="0.0" id="conf_maxOutput"/>
    <data expr="-1" id="conf_invalidInputMode"/>
    <data expr="-1" id="conf_minValidInput"/>
    <data expr="-1" id="conf_maxValidInput"/>
    <data expr="-1" id="conf_maxInvalidInputOccurences"/>
    <data expr="-1" id="conf_invalidInputOutput"/>
    <data expr="0" id="this_pid_invalidInputMode"/>
    <data expr="0" id="this_pid_minValidInput"/>
    <data expr="0" id="this_pid_maxValidInput"/>
    <data expr="0" id="this_pid_maxInvalidInputOccurences"/>
    <data expr="0" id="this_pid_invalidInputOutput"/>
    <data expr="0" id="this_pid_invalidInputCount"/>
    <data expr="false" id="this_pid_invalidInputMode_error"/>
    <data expr="false" id="this_pid_validInputRange_error"/>
    <data expr="false" id="this_pid_maxInvalidInputOccurences_error"/>
    <data expr="false" id="this_pid_invalidInputOutput_error"/>
    <data expr="0" id="this_pid_pidoperation"/>
    <data expr="0.0" id="this_pid_proportionalGain"/>
    <data expr="0.0" id="this_pid_controlPeriod"/>
    <data expr="0.0" id="this_pid_integralTime"/>
    <data expr="0.0" id="this_pid_derivativeTime"/>
    <data expr="0.0" id="this_pid_trackingTime"/>
    <data expr="0.0" id="this_pid_minOutput"/>
    <data expr="0.0" id="this_pid_maxOutput"/>
    <data expr="0.0" id="this_pid_u0"/>
    <data expr="0.0" id="this_pid_errorValue"/>
    <data expr="0.0" id="this_pid_errorminus1"/>
    <data expr="0.0" id="this_pid_P"/>
    <data expr="0.0" id="this_pid_I"/>
    <data expr="0.0" id="this_pid_D"/>
    <data expr="0.0" id="this_pid_u0Percentage"/>
    <data expr="0.0" id="this_pid_controlValue"/>
    <data expr="0.0" id="this_pid_buffer_output"/>
  </datamodel>
  <state id="mainregion" viz:xywh="20,20,200,120">
    <initial>
      <transition target="check_config" type="internal">
      </transition>
    </initial>
    <state id="check_config" viz:xywh="-169,-102,272,80">
      <transition target="operation" viz:sourceHandle="bottom" viz:targetHandle="left" cond="this_pid_maxInvalidInputOccurences_error == false &amp;&amp; this_pid_validInputRange_error == false &amp;&amp; this_pid_invalidInputOutput_error == false &amp;&amp; this_pid_invalidInputMode_error == false"/>
      <onentry>
        <assign location="this_pid_proportionalGain" expr="conf_proportionalGain"/>
        <assign location="this_pid_controlPeriod" expr="conf_controlPeriod"/>
        <assign location="this_pid_integralTime" expr="conf_integralTime"/>
        <assign location="this_pid_derivativeTime" expr="conf_derivativeTime"/>
        <assign location="this_pid_trackingTime" expr="conf_trackingTime"/>
        <assign location="this_pid_minOutput" expr="conf_minOutput"/>
        <assign location="this_pid_maxOutput" expr="conf_maxOutput"/>
        <assign location="this_pid_u0" expr="conf_minOutput"/>
        <assign location="this_pid_minValidInput" expr="conf_minValidInput"/>
        <assign location="this_pid_maxValidInput" expr="conf_maxValidInput"/>
        <assign location="this_pid_maxInvalidInputOccurences" expr="conf_maxInvalidInputOccurences"/>
        <assign location="this_pid_invalidInputMode" expr="conf_invalidInputMode"/>
        <assign location="this_pid_invalidInputOutput" expr="conf_invalidInputOutput"/>
        <assign location="this_pid_invalidInputMode_error" expr="this_pid_invalidInputMode != -1 &amp;&amp; this_pid_invalidInputMode != 0 &amp;&amp; this_pid_invalidInputMode != 1 ? true : false"/>
        <assign location="this_pid_validInputRange_error" expr="this_pid_invalidInputMode != -1 &amp;&amp; this_pid_minValidInput &gt;= this_pid_maxValidInput ? true : false"/>
        <assign location="this_pid_maxInvalidInputOccurences_error" expr="this_pid_invalidInputMode != -1 &amp;&amp; this_pid_maxInvalidInputOccurences &lt;= 0 ? true : false"/>
        <assign location="this_pid_invalidInputOutput_error" expr="this_pid_invalidInputMode != -1 &amp;&amp; this_pid_invalidInputMode == 1 &amp;&amp; (this_pid_invalidInputOutput &lt; this_pid_minOutput || this_pid_invalidInputOutput &gt; this_pid_maxOutput) ? true : false"/>
      </onentry>
    </state>
    <state id="alert_ack" viz:xywh="218,-22,166,80">
      <onentry>
        <assign location="this_output" expr="0.0"/>
        <assign location="this_pid_pidoperation" expr="0"/>
        <assign location="this_pid_errorValue" expr="0"/>
        <assign location="this_pid_errorminus1" expr="0"/>
        <assign location="this_pid_P" expr="0"/>
        <assign location="this_pid_I" expr="0"/>
        <assign location="this_pid_D" expr="0"/>
        <assign location="this_pid_u0Percentage" expr="0"/>
        <assign location="this_pid_controlValue" expr="0"/>
        <assign location="this_pid_buffer_output" expr="0"/>
      </onentry>
      <transition event="vector" type="internal">
        <assign location="this_output" expr="0.0"/>
      </transition>
      <transition event="ack" target="operation" viz:sourceHandle="bottom" viz:targetHandle="top"/>
    </state>
    <state id="operation" viz:xywh="200,119,200,120">
      <onentry>
        <assign location="this_pid_pidoperation" expr="1"/>
      </onentry>
      <initial>
        <transition target="run_when_target_is_set" type="internal"/>
      </initial>
      <state id="run_when_target_is_set" viz:xywh="20,140,397,120">
        <onentry>
          <send event="run_when_target_is_set_t_0_timeEvent_0" delayexpr="(conf_controlPeriod - conf_offTime) * 1000"/>
        </onentry>
        <onexit>
          <cancel sendid="run_when_target_is_set_t_0_timeEvent_0"/>
        </onexit>
        <initial>
          <transition target="calculate_values" type="internal"/>
        </initial>
        <state id="calculate_values" viz:xywh="20,140,321,80" initial="valid_value">
          <transition cond="this_target == 0" target="off" viz:sourceHandle="top" viz:targetHandle="bottom"/>
          <state id="invalid_value" viz:xywh="50,100,215,80">
            <onentry>
              <assign location="this_pid_controlPeriod" expr="this_pid_controlPeriod &gt;= 0.1 ? this_pid_controlPeriod : 0.1"/>
              <assign location="this_pid_integralTime" expr="this_pid_integralTime &gt;= 0.1 ? this_pid_integralTime : 0.1"/>
              <assign location="this_pid_trackingTime" expr="this_pid_trackingTime &gt;= 0.1 ? this_pid_trackingTime : 0.1"/>
              <assign location="this_pid_u0Percentage" expr="((this_pid_u0 - this_pid_minOutput) / (this_pid_maxOutput - this_pid_minOutput)) * 100.0"/>
              <assign location="this_pid_errorminus1" expr="this_pid_invalidInputMode == 0 ? this_pid_errorminus1 : 0"/>
              <assign location="this_pid_errorValue" expr="this_pid_invalidInputMode == 0 ? this_pid_errorValue : 0"/>
              <assign location="this_pid_P" expr="this_pid_invalidInputMode == 0 ? this_pid_P : 0"/>
              <assign location="this_pid_I" expr="this_pid_invalidInputMode == 0 ? this_pid_I : 0"/>
              <assign location="this_pid_D" expr="this_pid_invalidInputMode == 0 ? this_pid_D : 0"/>
              <assign location="this_pid_controlValue" expr="this_pid_invalidInputMode == 0 ? this_pid_controlValue : 0"/>
              <assign location="this_pid_buffer_output" expr="this_pid_invalidInputMode == 0 ? this_pid_buffer_output : 0"/>
              <assign location="this_output" expr="this_pid_invalidInputMode == 0 ? this_output : this_pid_invalidInputOutput"/>
            </onentry>
            <transition event="vector" type="internal">
              <assign location="this_output" expr="this_pid_invalidInputMode == 0 ? this_output : this_pid_invalidInputOutput"/>
            </transition>
            <transition target="valid_value" viz:sourceHandle="right" viz:targetHandle="right" cond="this_pid_invalidInputCount != this_pid_maxInvalidInputOccurences"/>
          </state>
          <state id="valid_value" viz:xywh="-46,279,252,80">
            <onentry>
              <assign location="this_pid_controlPeriod" expr="this_pid_controlPeriod &gt;= 0.1 ? this_pid_controlPeriod : 0.1"/>
              <assign location="this_pid_integralTime" expr="this_pid_integralTime &gt;= 0.1 ? this_pid_integralTime : 0.1"/>
              <assign location="this_pid_trackingTime" expr="this_pid_trackingTime &gt;= 0.1 ? this_pid_trackingTime : 0.1"/>
              <assign location="this_pid_u0Percentage" expr="((this_pid_u0 - this_pid_minOutput) / (this_pid_maxOutput - this_pid_minOutput)) * 100.0"/>
              <assign location="this_pid_errorminus1" expr="this_pid_errorValue"/>
              <assign location="this_pid_errorValue" expr="this_target - this_input"/>
              <assign location="this_pid_P" expr="this_pid_proportionalGain * this_pid_errorValue"/>
              <assign location="this_pid_I" expr="this_pid_I + (this_pid_proportionalGain * this_pid_controlPeriod / this_pid_integralTime) * this_pid_errorValue"/>
              <assign location="this_pid_D" expr="((this_pid_proportionalGain * this_pid_derivativeTime) / this_pid_controlPeriod) * (this_pid_errorValue - this_pid_errorminus1)"/>
              <assign location="this_pid_controlValue" expr="this_pid_u0Percentage + this_pid_P + this_pid_I + this_pid_D"/>
              <assign location="this_pid_I" expr="this_pid_controlValue &gt; 100.0 ? this_pid_I - ((this_pid_controlValue - 100.0) * this_pid_controlPeriod / this_pid_trackingTime) : this_pid_I"/>
              <assign location="this_pid_I" expr="this_pid_controlValue &lt; 0.0 ? this_pid_I - (this_pid_controlValue * this_pid_controlPeriod / this_pid_trackingTime) : this_pid_I"/>
              <assign location="this_pid_controlValue" expr="this_pid_u0Percentage + this_pid_P + this_pid_I + this_pid_D"/>
              <assign location="this_pid_buffer_output" expr="this_pid_minOutput + (this_pid_maxOutput - this_pid_minOutput) * this_pid_controlValue / 100.0"/>
              <assign location="this_pid_buffer_output" expr="this_pid_buffer_output &gt; this_pid_maxOutput ? this_pid_maxOutput : this_pid_buffer_output"/>
              <assign location="this_pid_buffer_output" expr="this_pid_buffer_output &lt; this_pid_minOutput ? this_pid_minOutput : this_pid_buffer_output"/>
              <assign location="this_output" expr="this_pid_buffer_output"/>
            </onentry>
            <transition event="vector" type="internal">
              <assign location="this_output" expr="this_pid_buffer_output"/>
            </transition>
            <transition target="invalid_value" viz:sourceHandle="left" viz:targetHandle="left" cond="this_pid_invalidInputCount == this_pid_maxInvalidInputOccurences"/>
          </state>
          <onentry>
            <assign location="this_pid_invalidInputCount" expr="(this_pid_invalidInputMode != -1 &amp;&amp; (this_input &lt; this_pid_minValidInput || this_input &gt; this_pid_maxValidInput)) ? this_pid_invalidInputCount + 1 : 0"/>
          </onentry>
        </state>
        <state id="off" viz:xywh="114,20,160,80">
          <transition event="vector" type="internal">
            <assign location="this_output" expr="this_pid_buffer_output"/>
          </transition>
          <transition cond="this_target != 0" target="calculate_values" viz:sourceHandle="right" viz:targetHandle="right"/>
          <onentry>
            <assign location="this_output" expr="0.0"/>
            <assign location="this_pid_pidoperation" expr="0"/>
            <assign location="this_pid_errorValue" expr="0"/>
            <assign location="this_pid_errorminus1" expr="0"/>
            <assign location="this_pid_P" expr="0"/>
            <assign location="this_pid_I" expr="0"/>
            <assign location="this_pid_D" expr="0"/>
            <assign location="this_pid_u0Percentage" expr="0"/>
            <assign location="this_pid_controlValue" expr="0"/>
            <assign location="this_pid_buffer_output" expr="0"/>
          </onentry>
        </state>
        <transition event="run_when_target_is_set_t_0_timeEvent_0" target="trigger_next_period" viz:sourceHandle="top" viz:targetHandle="bottom"/>
      </state>
      <state id="trigger_next_period" viz:xywh="110,20,263,80">
        <onentry>
          <send event="trigger_next_period_t_0_timeEvent_0" delayexpr="conf_offTime * 1000"/>
        </onentry>
        <onentry>
          <assign location="this_output" expr="0"/>
        </onentry>
        <onexit>
          <cancel sendid="trigger_next_period_t_0_timeEvent_0"/>
        </onexit>
        <transition event="vector" type="internal">
          <assign location="this_output" expr="0"/>
        </transition>
        <transition event="trigger_next_period_t_0_timeEvent_0" target="run_when_target_is_set" viz:sourceHandle="right" viz:targetHandle="right"/>
      </state>
      <transition event="emergencyshutdown" target="alert_ack" viz:sourceHandle="right" viz:targetHandle="right"/>
    </state>
  </state>
</scxml>