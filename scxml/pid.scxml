<scxml xmlns="http://www.w3.org/2005/07/scxml" xmlns:viz="http://visual-scxml-editor/metadata" version="1.0" name="pid" initial="mainregion">
  <datamodel>
    <data expr="0.0" id="input"/>
    <data expr="0.0" id="output"/>
    <data expr="0.0" id="target"/>
    <data expr="0.1" id="conf_proportionalGain"/>
    <data expr="600.0" id="conf_integralTime"/>
    <data expr="0.0" id="conf_derivativeTime"/>
    <data expr="20" id="conf_controlPeriod"/>
    <data expr="0" id="conf_offTime"/>
    <data expr="40" id="conf_trackingTime"/>
    <data expr="0.0" id="conf_minOutput"/>
    <data expr="0.0" id="conf_maxOutput"/>
    <data expr="-1" id="conf_invalidInputMode"/>
    <data expr="-1" id="conf_minValidInput"/>
    <data expr="-1" id="conf_maxValidInput"/>
    <data expr="-1" id="conf_maxInvalidInputOccurences"/>
    <data expr="-1" id="conf_invalidInputOutput"/>
    <data expr="0" id="this_invalidInputMode"/>
    <data expr="0" id="this_minValidInput"/>
    <data expr="0" id="this_maxValidInput"/>
    <data expr="0" id="this_maxInvalidInputOccurences"/>
    <data expr="0" id="this_invalidInputOutput"/>
    <data expr="0" id="this_invalidInputCount"/>
    <data expr="false" id="this_invalidInputMode_error"/>
    <data expr="false" id="this_validInputRange_error"/>
    <data expr="false" id="this_maxInvalidInputOccurences_error"/>
    <data expr="false" id="this_invalidInputOutput_error"/>
    <data expr="0" id="this_pidoperation"/>
    <data expr="0.0" id="this_proportionalGain"/>
    <data expr="0.0" id="this_controlPeriod"/>
    <data expr="0.0" id="this_integralTime"/>
    <data expr="0.0" id="this_derivativeTime"/>
    <data expr="0.0" id="this_trackingTime"/>
    <data expr="0.0" id="this_minOutput"/>
    <data expr="0.0" id="this_maxOutput"/>
    <data expr="0.0" id="this_u0"/>
    <data expr="0.0" id="this_errorValue"/>
    <data expr="0.0" id="this_errorminus1"/>
    <data expr="0.0" id="this_P"/>
    <data expr="0.0" id="this_I"/>
    <data expr="0.0" id="this_D"/>
    <data expr="0.0" id="this_u0Percentage"/>
    <data expr="0.0" id="this_controlValue"/>
    <data expr="0.0" id="this_buffer_output"/>
  </datamodel>
  <state id="mainregion" viz:xywh="20,20,200,120">
    <initial>
      <transition target="check_config" type="internal">
      </transition>
    </initial>
    <state id="check_config" viz:xywh="-169,-102,272,80">
      <transition target="operation" viz:sourceHandle="bottom" viz:targetHandle="left" cond="this_maxInvalidInputOccurences_error == false &amp;&amp; this_validInputRange_error == false &amp;&amp; this_invalidInputOutput_error == false &amp;&amp; this_invalidInputMode_error == false"/>
      <onentry>
        <assign location="this_proportionalGain" expr="conf_proportionalGain"/>
        <assign location="this_controlPeriod" expr="conf_controlPeriod"/>
        <assign location="this_integralTime" expr="conf_integralTime"/>
        <assign location="this_derivativeTime" expr="conf_derivativeTime"/>
        <assign location="this_trackingTime" expr="conf_trackingTime"/>
        <assign location="this_minOutput" expr="conf_minOutput"/>
        <assign location="this_maxOutput" expr="conf_maxOutput"/>
        <assign location="this_u0" expr="conf_minOutput"/>
        <assign location="this_minValidInput" expr="conf_minValidInput"/>
        <assign location="this_maxValidInput" expr="conf_maxValidInput"/>
        <assign location="this_maxInvalidInputOccurences" expr="conf_maxInvalidInputOccurences"/>
        <assign location="this_invalidInputMode" expr="conf_invalidInputMode"/>
        <assign location="this_invalidInputOutput" expr="conf_invalidInputOutput"/>
        <assign location="this_invalidInputMode_error" expr="this_invalidInputMode != -1 &amp;&amp; this_invalidInputMode != 0 &amp;&amp; this_invalidInputMode != 1 ? true : false"/>
        <assign location="this_validInputRange_error" expr="this_invalidInputMode != -1 &amp;&amp; this_minValidInput &gt;= this_maxValidInput ? true : false"/>
        <assign location="this_maxInvalidInputOccurences_error" expr="this_invalidInputMode != -1 &amp;&amp; this_maxInvalidInputOccurences &lt;= 0 ? true : false"/>
        <assign location="this_invalidInputOutput_error" expr="this_invalidInputMode != -1 &amp;&amp; this_invalidInputMode == 1 &amp;&amp; (this_invalidInputOutput &lt; this_minOutput || this_invalidInputOutput &gt; this_maxOutput) ? true : false"/>
      </onentry>
    </state>
    <state id="alert_ack" viz:xywh="218,-22,166,80">
      <onentry>
        <assign location="output" expr="0.0"/>
        <assign location="this_pidoperation" expr="0"/>
        <assign location="this_errorValue" expr="0"/>
        <assign location="this_errorminus1" expr="0"/>
        <assign location="this_P" expr="0"/>
        <assign location="this_I" expr="0"/>
        <assign location="this_D" expr="0"/>
        <assign location="this_u0Percentage" expr="0"/>
        <assign location="this_controlValue" expr="0"/>
        <assign location="this_buffer_output" expr="0"/>
      </onentry>
      <transition event="vector" type="internal">
        <assign location="output" expr="0.0"/>
      </transition>
      <transition event="ack" target="operation" viz:sourceHandle="bottom" viz:targetHandle="top"/>
    </state>
    <state id="operation" viz:xywh="200,119,200,120">
      <onentry>
        <assign location="this_pidoperation" expr="1"/>
      </onentry>
      <initial>
        <transition target="run_when_target_is_set" type="internal"/>
      </initial>
      <state id="run_when_target_is_set" viz:xywh="20,140,397,120">
        <onentry>
          <send event="run_when_target_is_set_t_0_timeEvent_0" delayexpr="(conf_controlPeriod - conf_offTime) * 1000"/>
        </onentry>
        <onexit>
          <cancel sendid="run_when_target_is_set_t_0_timeEvent_0"/>
        </onexit>
        <initial>
          <transition target="calculate_values" type="internal"/>
        </initial>
        <state id="calculate_values" viz:xywh="20,140,321,80" initial="valid_value">
          <transition cond="target == 0" target="off" viz:sourceHandle="top" viz:targetHandle="bottom"/>
          <state id="invalid_value" viz:xywh="50,100,215,80">
            <onentry>
              <assign location="this_controlPeriod" expr="this_controlPeriod &gt;= 0.1 ? this_controlPeriod : 0.1"/>
              <assign location="this_integralTime" expr="this_integralTime &gt;= 0.1 ? this_integralTime : 0.1"/>
              <assign location="this_trackingTime" expr="this_trackingTime &gt;= 0.1 ? this_trackingTime : 0.1"/>
              <assign location="this_u0Percentage" expr="((this_u0 - this_minOutput) / (this_maxOutput - this_minOutput)) * 100.0"/>
              <assign location="this_errorminus1" expr="this_invalidInputMode == 0 ? this_errorminus1 : 0"/>
              <assign location="this_errorValue" expr="this_invalidInputMode == 0 ? this_errorValue : 0"/>
              <assign location="this_P" expr="this_invalidInputMode == 0 ? this_P : 0"/>
              <assign location="this_I" expr="this_invalidInputMode == 0 ? this_I : 0"/>
              <assign location="this_D" expr="this_invalidInputMode == 0 ? this_D : 0"/>
              <assign location="this_controlValue" expr="this_invalidInputMode == 0 ? this_controlValue : 0"/>
              <assign location="this_buffer_output" expr="this_invalidInputMode == 0 ? this_buffer_output : 0"/>
              <assign location="output" expr="this_invalidInputMode == 0 ? output : this_invalidInputOutput"/>
            </onentry>
            <transition event="vector" type="internal">
              <assign location="output" expr="this_invalidInputMode == 0 ? output : this_invalidInputOutput"/>
            </transition>
            <transition target="valid_value" viz:sourceHandle="right" viz:targetHandle="right" cond="this_invalidInputCount != this_maxInvalidInputOccurences"/>
          </state>
          <state id="valid_value" viz:xywh="-46,279,252,80">
            <onentry>
              <assign location="this_controlPeriod" expr="this_controlPeriod &gt;= 0.1 ? this_controlPeriod : 0.1"/>
              <assign location="this_integralTime" expr="this_integralTime &gt;= 0.1 ? this_integralTime : 0.1"/>
              <assign location="this_trackingTime" expr="this_trackingTime &gt;= 0.1 ? this_trackingTime : 0.1"/>
              <assign location="this_u0Percentage" expr="((this_u0 - this_minOutput) / (this_maxOutput - this_minOutput)) * 100.0"/>
              <assign location="this_errorminus1" expr="this_errorValue"/>
              <assign location="this_errorValue" expr="target - input"/>
              <assign location="this_P" expr="this_proportionalGain * this_errorValue"/>
              <assign location="this_I" expr="this_I + (this_proportionalGain * this_controlPeriod / this_integralTime) * this_errorValue"/>
              <assign location="this_D" expr="((this_proportionalGain * this_derivativeTime) / this_controlPeriod) * (this_errorValue - this_errorminus1)"/>
              <assign location="this_controlValue" expr="this_u0Percentage + this_P + this_I + this_D"/>
              <assign location="this_I" expr="this_controlValue &gt; 100.0 ? this_I - ((this_controlValue - 100.0) * this_controlPeriod / this_trackingTime) : this_I"/>
              <assign location="this_I" expr="this_controlValue &lt; 0.0 ? this_I - (this_controlValue * this_controlPeriod / this_trackingTime) : this_I"/>
              <assign location="this_controlValue" expr="this_u0Percentage + this_P + this_I + this_D"/>
              <assign location="this_buffer_output" expr="this_minOutput + (this_maxOutput - this_minOutput) * this_controlValue / 100.0"/>
              <assign location="this_buffer_output" expr="this_buffer_output &gt; this_maxOutput ? this_maxOutput : this_buffer_output"/>
              <assign location="this_buffer_output" expr="this_buffer_output &lt; this_minOutput ? this_minOutput : this_buffer_output"/>
              <assign location="output" expr="this_buffer_output"/>
            </onentry>
            <transition event="vector" type="internal">
              <assign location="output" expr="this_buffer_output"/>
            </transition>
            <transition target="invalid_value" viz:sourceHandle="left" viz:targetHandle="left" cond="this_invalidInputCount == this_maxInvalidInputOccurences"/>
          </state>
          <onentry>
            <assign location="this_invalidInputCount" expr="(this_invalidInputMode != -1 &amp;&amp; (input &lt; this_minValidInput || input &gt; this_maxValidInput)) ? this_invalidInputCount + 1 : 0"/>
          </onentry>
        </state>
        <state id="off" viz:xywh="114,20,160,80">
          <transition event="vector" type="internal">
            <assign location="output" expr="this_buffer_output"/>
          </transition>
          <transition cond="target != 0" target="calculate_values" viz:sourceHandle="right" viz:targetHandle="right"/>
          <onentry>
            <assign location="output" expr="0.0"/>
            <assign location="this_pidoperation" expr="0"/>
            <assign location="this_errorValue" expr="0"/>
            <assign location="this_errorminus1" expr="0"/>
            <assign location="this_P" expr="0"/>
            <assign location="this_I" expr="0"/>
            <assign location="this_D" expr="0"/>
            <assign location="this_u0Percentage" expr="0"/>
            <assign location="this_controlValue" expr="0"/>
            <assign location="this_buffer_output" expr="0"/>
          </onentry>
        </state>
        <transition event="run_when_target_is_set_t_0_timeEvent_0" target="trigger_next_period" viz:sourceHandle="top" viz:targetHandle="bottom"/>
      </state>
      <state id="trigger_next_period" viz:xywh="110,20,263,80">
        <onentry>
          <send event="trigger_next_period_t_0_timeEvent_0" delayexpr="conf_offTime * 1000"/>
        </onentry>
        <onentry>
          <assign location="output" expr="0"/>
        </onentry>
        <onexit>
          <cancel sendid="trigger_next_period_t_0_timeEvent_0"/>
        </onexit>
        <transition event="vector" type="internal">
          <assign location="output" expr="0"/>
        </transition>
        <transition event="trigger_next_period_t_0_timeEvent_0" target="run_when_target_is_set" viz:sourceHandle="right" viz:targetHandle="right"/>
      </state>
      <transition event="emergencyshutdown" target="alert_ack" viz:sourceHandle="right" viz:targetHandle="right"/>
    </state>
  </state>
</scxml>